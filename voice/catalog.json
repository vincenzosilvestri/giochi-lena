  "h": "480aac90",
  "text": "Lena Salta"
 },
 {
  "h": "d7039388",
  "text": "Stop! È rosso: aspetta il verde!"
 },
 {
  "h": "cb189110",
  "text": "Fermati! Col rosso non si passa."
 },
 {
  "h": "e0911e69",
  "text": "Rosso! Aspettiamo il verde."
 },
 {
  "h": "1284dcb3",
  "text": "Brava! Col verde si passa!"
 },
 {
  "h": "ad05be20",
  "text": "Verde: via libera!"
 },
 {
  "h": "09d9a7ca",
  "text": "Perfetto, hai aspettato il verde!"
 },
 {
  "h": "5c99357f",
  "text": "Super! Attraversamento sicuro!"
 },
 {
  "h": "f73937f1",
  "text": "Tocca lo schermo per saltare avanti!"
 },
 {
  "h": "200592b9",
  "text": "Striscia il dito di lato per spostarti."
 },
 {
  "h": "938339e0",
  "text": "Semaforo rosso: fermati e aspetta!"
 },
 {
  "h": "a96ce765",
  "text": "Semaforo verde: le macchine si fermano e puoi passare!"
 },
 {
  "h": "05ada735",
  "text": "Attenzione ai fiumi: salta sui tronchi!"
 },
 {
  "h": "ac90756c",
  "text": "Ops! Attenta alle macchine!"
 },
 {
  "h": "d0fdfa31",
  "text": "Ops! Guarda bene prima di saltare!"
 },
 {
  "h": "0023b08a",
  "text": "Tocca per saltare. Col rosso aspetta, col verde passa!"
 },
 {
  "h": "8af86031",
  "text": "Splash! Salta sui tronchi!"
 },
 {
  "h": "8c2d171c",
  "text": "Ops! Il semaforo è diventato rosso: attraversa quando è appena verde!"
 },
 {
